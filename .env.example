# Copy to .env for LOCAL development only. Never commit .env.
SAFEVAULT_PIN=000000
SECRET_KEY=change-me-to-a-long-random-string
GEMINI_API_KEY=your-gemini-api-key

# Optional
# SAFEVAULT_STORAGE_PATH=/path/to/persistent/dir   (holds safevault.db + uploads/)
# SAFEVAULT_SESSION_MINUTES=120
# SAFEVAULT_DEBUG=1                                  (local development only)
